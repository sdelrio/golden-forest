      "css": ".ds-pill{display:inline-flex;align-items:center;gap:.375rem;padding:.375rem .75rem;border-radius:9999px;border:1px solid var(--ifm-color-emphasis-300);background:transparent;color:var(--ifm-font-color-base);font-size:.8125rem;font-weight:500;cursor:pointer;transition:all .15s ease}.ds-pill:hover{border-color:var(--ifm-color-primary);color:var(--ifm-color-primary)}.ds-pill:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}.ds-pill-active{background:var(--ifm-color-primary);border-color:var(--ifm-color-primary);color:var(--ink,#2a2010)}.ds-pill-active:hover{color:var(--ink,#2a2010);opacity:.9}.ds-pill-count{background:rgba(255,255,255,.2);padding:0 .375rem;border-radius:9999px;font-size:.6875rem;font-weight:700;min-width:1.25rem;text-align:center}.ds-pill-active .ds-pill-count{background:rgba(255,255,255,.25)}"
