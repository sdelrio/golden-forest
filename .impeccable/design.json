      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;border-radius:9999px;padding:2px 10px 2px 8px;font-weight:600;font-size:.75rem;line-height:1.4;white-space:nowrap}.ds-badge-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}.ds-badge-fresh{background:rgba(34,197,94,.12)}.ds-badge-fresh .ds-badge-dot{background:#22c55e}.ds-badge-fresh{color:#15803d}.ds-badge-stale{background:rgba(245,158,11,.12);color:#b45309}.ds-badge-stale .ds-badge-dot{background:#f59e0b}.ds-badge-outdated{background:rgba(239,68,68,.12);color:#dc2626}.ds-badge-outdated .ds-badge-dot{background:#ef4444}"
