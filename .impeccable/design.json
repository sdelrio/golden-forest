  "components": [
    {
      "name": "Code Plaque",
      "kind": "custom",
      "refersTo": "code-block",
      "description": "Full-width terminal frame: bark plaque with a 28px amber lid and three leaf controls.",
      "html": "<div class=\"ds-plaque\"><span class=\"ds-plaque-leaf ds-leaf-red\"></span><span class=\"ds-plaque-leaf ds-leaf-amber\"></span><span class=\"ds-plaque-leaf ds-leaf-green\"></span><span class=\"ds-plaque-title\">bash</span><pre class=\"ds-plaque-code\">$ task build</pre></div>",
      "css": ".ds-plaque{position:relative;border-radius:28px 12px 35px 15px;overflow:hidden;padding:calc(32px + .25rem) .5rem .5rem;background-color:#2b2b2b;border:2px solid var(--ifm-color-primary-darkest);margin:1.5rem 0}.ds-plaque::before{content:'';position:absolute;top:0;left:0;right:0;height:28px;background:linear-gradient(to bottom,var(--ifm-color-primary-darker),var(--ifm-color-primary-darkest));border-bottom:2px solid var(--ifm-color-primary-darker)}.ds-plaque-leaf{position:absolute;top:5px;width:18px;height:18px;z-index:2;clip-path:polygon(50% 0,95% 45%,50% 100%,5% 45%)}.ds-leaf-red{left:14px;background:#d32f2f}.ds-leaf-amber{left:34px;background:#e99700}.ds-leaf-green{left:54px;background:#388e3c}.ds-plaque-title{position:absolute;top:4px;left:80px;height:28px;line-height:28px;font-size:.85rem;font-weight:600;color:#e2e2e2;z-index:5;pointer-events:none;text-shadow:1px 1px 1px rgba(0,0,0,.5)}.ds-plaque-code{margin:0;padding:.5rem;background:transparent;color:#e6e6e6;font-family:Source Code Pro,Consolas,Menlo,monospace;font-size:14px;font-weight:350;line-height:1.5;white-space:pre-wrap}"
    },
